# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments and local Python tooling
.venv/
venv/
env/
ENV/

# Local environment and secrets
.env
.env.*
!.env.example

# Downloaded datasets and derived data
# Keep data/splits/ versioned so every experiment can reuse the same manifests.
data/raw/**
data/processed/**
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained models and generated experiment artifacts
checkpoints/**
outputs/**
!checkpoints/**/
!checkpoints/.gitkeep
!outputs/**/
!outputs/.gitkeep
!outputs/**/.gitkeep

# Experiment tracking and logs
wandb/
mlruns/
*.log

# Jupyter and notebook-generated files
.ipynb_checkpoints/
*.nbconvert.ipynb

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
